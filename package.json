{
  "name": "payago-landing-ui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "tsc --noEmit --incremental false",
    "preview": "python3 -m http.server ${PORT:-4173} --bind ${HOST:-127.0.0.1} --directory out",
    "start": "pnpm preview",
    "test": "pnpm typecheck && pnpm test:e2e",
    "test:e2e": "NEXT_PUBLIC_WAITLIST_ENDPOINT=https://tests.payago.local/waitlist NEXT_PUBLIC_CONTACT_ENDPOINT=https://tests.payago.local/contact pnpm build && playwright test",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-slot": "1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.454.0",
    "next": "16.4.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^2.5.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.9",
    "@types/d3-geo": "^3.1.1",
