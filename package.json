    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.1.9",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "1.3.3",
    "typescript": "^5",
    "world-atlas": "^2.0.2"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.5",
      "nanoid": "^3.3.18",
      "postcss": "^8.5.26",
      "baseline-browser-mapping": "^2.11.0",
      "source-map-js": ">=1.2.2"
